# Copy to ~/.config/multi-account-gmail-mcp/.env (or set as environment variables).
# NEVER commit the real file.
GMAIL_CLIENT_ID=1234567890-example.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-example
GMAIL_TOKEN_PERSONAL=1//0g-example-refresh-token
GMAIL_TOKEN_WORK=1//0g-example-refresh-token
GMAIL_CONFIG={"default_account":"personal","accounts":{"work":{"permissions":["read","draft","organize"]}}}
